# Docker
# Nom du projet Compose
COMPOSE_PROJECT_NAME=aioli

#AIOLI_WEB_IMAGE=aioli-web:prod
AIOLI_WEB_IMAGE=gitlab.espadon.net/espadon/aioli-stratigraph/web
#AIOLI_DATA_API_IMAGE=aioli-data-api:prod
AIOLI_DATA_API_IMAGE=gitlab.espadon.net/espadon/aioli-stratigraph/data-api
# Chemin ABSOLU de ce dossier sur l'hôte 
HOST_PROJECT_PATH=# Chemin ABSOLU de ce dossier sur l'hôte
# Ports exposés
WEB_PORT=8080
COUCHDB_PORT=5984
KEYCLOAK_PORT=8081
# aioli-data-api
API_PORT=8001

# Aïoli
# Keycloak 
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KC_HOSTNAME=http://localhost:8081

# CouchDB 
COUCHDB_USER=admin
COUCHDB_PASSWORD=password

# Configuration SMTP
MAIL_PROTOCOL=smtp
MAIL_HOST=13.5.22.100
MAIL_PORT=25
MAIL_AUTH=false
MAIL_FROM=noreply@cnrs.fr
MAIL_TRANSPORT=smtp

# Configuration Keycloak 
KEYCLOAK_CLIENT_ID=AioliClient
KEYCLOAK_CLIENT_SECRET=(Ex:gggggwt2lA2gRMAAGmcqR72oC0FHXhlOXBenK)
KEYCLOAK_CALLBACK_URL=http://localhost:8080/_proc/keycloak_callback
KEYCLOAK_ISSUER=http://localhost:8081/realms/testAioli
KEYCLOAK_AUTHORIZATION_ENDPOINT=http://localhost:8081/realms/testAioli/protocol/openid-connect/auth
KEYCLOAK_TOKEN_ENDPOINT=http://keycloak:8080/realms/testAioli/protocol/openid-connect/token
KEYCLOAK_USERINFO_ENDPOINT=http://keycloak:8080/realms/testAioli/protocol/openid-connect/userinfo
KEYCLOAK_END_SESSION_ENDPOINT=http://localhost:8081/realms/testAioli/protocol/openid-connect/logout

# aioli-data-api
SYNC_BATCH_SIZE=500
SYNC_POINTCLOUD_METADATA=false
DELETE_MODE=soft
# Keycloak pour l'API
DATA_API_KEYCLOAK_URL=http://localhost:8081
DATA_API_KEYCLOAK_INTERNAL_URL=http://keycloak:8080
DATA_API_KEYCLOAK_REALM=testAioli
DATA_API_KEYCLOAK_CLIENT_ID=aioli-data-api
DATA_API_KEYCLOAK_ROLE_CLIENT_ID=aioli-data-api
DATA_API_KEYCLOAK_SWAGGER_CLIENT_ID=aioli-data-api-swagger

# ArangoDB
ARANGO_PORT=8530
ARANGO_VERSION=3.11.14
ARANGO_DB=aioli
ARANGO_ROOT_PASSWORD=c9b942cea3d30c70e5095f7ce0e6a735

# Registre des images de traitement
PROCESSING_REGISTRY=gitlab.espadon.net/espadon/aioli-stratigraph
